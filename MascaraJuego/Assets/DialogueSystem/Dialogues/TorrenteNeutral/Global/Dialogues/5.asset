  <DialogueName>k__BackingField: 5
  <Text>k__BackingField: Say, you wouldn't have five euros for the bus?
  <SpeakerName>k__BackingField: Officer Torrent
  <Choices>k__BackingField:
  - <Text>k__BackingField: Are you cosplaying?
    <NextDialogue>k__BackingField: {fileID: 11400000, guid: 7832ef3747475b04eaee0df35df9e140, type: 2}
  - <Text>k__BackingField: Did you see that asian girl?
    <NextDialogue>k__BackingField: {fileID: 11400000, guid: 63cf11fe93170c645896ee18a3a09b2b, type: 2}
  - <Text>k__BackingField: No, sorry. I don't have a penny
    <NextDialogue>k__BackingField: {fileID: 11400000, guid: 605646507e9edbc44a1099ba65564874, type: 2}
  - <Text>k__BackingField: Goodbye
    <NextDialogue>k__BackingField: {fileID: 11400000, guid: 5e21120c014335c48899e559eb254d97, type: 2}
