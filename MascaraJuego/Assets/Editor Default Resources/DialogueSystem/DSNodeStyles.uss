/* CONTAINERS */
.ds-node__extension-container {
    background-color: var(--ds-colors-window-dark-grey-1);
    padding: 8px;
}

.ds-node__main-container {
    background-color: var(--ds-colors-window-dark-grey-1);
}

.ds-node__custom-data-container {
    background-color: var(--ds-colors-window-dark-grey-3);
    border-radius: 4px;
    padding: 8px;
}

/* INPUTS */
.ds-node__textfield > .unity-text-field__input {
    background-color: var(--ds-colors-window-dark-grey-1);
    border-color: var(--ds-colors-window-dark-grey-6);
    border-radius: 4px;
    max-width: 240px;
    min-width: 160px;
    padding: 8px;
    width: 100%; /* Asegura que el textfield usa todo el ancho posible */
}

.ds-node__textfield__hidden > .unity-text-field__input {
    background-color: transparent;
    border-color: transparent;
}

.ds-node__textfield__hidden > .unity-text-field__input:focus {
    background-color: var(--ds-colors-window-dark-grey-1);
    border-color: var(--ds-colors-window-dark-grey-6);
}

.ds-node__filename-textfield > .unity-text-field__input {
    max-width: 1000px;
}

.ds-node__filename-textfield > .unity-text-field__input:focus {
    margin: 4px;
    padding: 4px;
}

.ds-node__choice-textfield > .unity-text-field__input {
    font-size: 11px;
    height: 35px;
    max-width: 160px;
}

.ds-node__choice-textfield > .unity-text-field__input:focus {
    height: 25px;
    margin: 4px;
    padding: 4px;
}

.ds-node__quote-textfield > .unity-text-field__input {
    background-color: var(--ds-colors-window-dark-grey-4);
    border-color: transparent;
    border-left-color: var(--ds-colors-window-dark-grey-6);
    border-left-width: 4px;
    padding: 16px;
    max-width: 600px;
}

.ds-node__quote-textfield > .unity-text-field__input:hover {
    background-color: var(--ds-colors-window-dark-grey-5);
}

.ds-node__quote-textfield > .unity-text-field__input:focus {
    background-color: var(--ds-colors-window-dark-grey-1);
    border-color: var(--ds-colors-window-dark-grey-6);
}

/* BUTTONS */
.ds-node__button {
    background-color: var(--ds-colors-window-dark-grey-5);
    border-color: var(--ds-colors-window-dark-grey-1);
    max-height: 25px;
    margin: 4px;
}

.ds-node__button:hover {
    background-color: var(--ds-colors-window-dark-grey-2);
}

.ds-node__button:active {
    background-color: var(--ds-colors-window-dark-grey-4);
    color: var(--ds-colors-window-pink);
}

/* ELEMENTS */
TextField {
    margin-left: 0;
}

.ds-node__custom-data-container > Foldout {
    margin-left: -4px;
    margin-top: 4px;
}

.ds-node__custom-data-container > Foldout > TextField {
    margin-left: -12px;
    margin-top: 8px;
}

/* BUILT IN */
.unity-toggle-text {
    margin-left: 2px;
}

/* CHOICE CONTAINER */
.ds-node__choice-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%; 
    margin-right: 8px; 
}

/* IMAGE FIELDS */
.ds-node__image-field > .unity-object-field__input {
    background-color: var(--ds-colors-window-dark-grey-4); 
    border-color: var(--ds-colors-window-dark-grey-6);
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 8px; 
    min-height: 40px; 
    max-width: 240px;
    width: 100%; 
}

.ds-node__image-field > .unity-object-field__input:hover {
    background-color: var(--ds-colors-window-dark-grey-5); 
}

.ds-node__image-field > .unity-object-field__input:focus {
    background-color: var(--ds-colors-window-dark-grey-3); 
    border-color: var(--ds-colors-window-dark-grey-6); 
}

/* IMAGE LABEL */
.ds-node__dialogue-label {
    color: var(--ds-colors-window-light-grey);
    margin-bottom: 4px; 
    font-size: 13px;
    font-weight: bold; 
