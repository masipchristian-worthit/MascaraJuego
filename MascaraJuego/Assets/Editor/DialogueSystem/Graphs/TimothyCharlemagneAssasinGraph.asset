  - <ID>k__BackingField: e830d0c9-8dab-4848-99ee-2277990ddef4
    <Name>k__BackingField: 44
    <Text>k__BackingField: The humidity in this room is a tragedy.
    <SpeakerName>k__BackingField: Timothy Charlemagne
    <Choices>k__BackingField:
    - <Text>k__BackingField: Next DIalogue
      <NodeID>k__BackingField: 863d73b7-f88e-4b33-8647-9e65c160bae8
    <GroupID>k__BackingField: 
    <DialogueSpeed>k__BackingField: 
