  - <ID>k__BackingField: 762904b7-3a22-4141-b980-c0c2f191640c
    <Name>k__BackingField: 47
    <Text>k__BackingField: Do you think I look mysterious enough standing here?
    <SpeakerName>k__BackingField: Timothy Charlemagne
    <Choices>k__BackingField:
    - <Text>k__BackingField: Next DIalogue
      <NodeID>k__BackingField: e6f44d2f-8f11-4822-994b-60c2cbdabdbd
