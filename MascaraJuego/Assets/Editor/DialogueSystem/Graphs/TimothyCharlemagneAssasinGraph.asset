    <Actions>k__BackingField: 
    <HintSo>k__BackingField: {fileID: 0}
  - <ID>k__BackingField: 3b5fd744-c20e-4bad-aa07-d9b8e0495ac3
    <Name>k__BackingField: 46
    <Text>k__BackingField: "I feel like a Renaissance painting that\u2019s been left
      out in the rain. I\u2019m thinking of leaving early to go sit on a roof and
      read Baudelaire to stray cats."
    <SpeakerName>k__BackingField: Timothy Charlemagne
    <Choices>k__BackingField:
    - <Text>k__BackingField: Next DIalogue
      <NodeID>k__BackingField: 762904b7-3a22-4141-b980-c0c2f191640c
